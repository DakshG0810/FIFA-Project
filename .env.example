# The Odds API — https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# Database (blank = SQLite wc_dashboard.db in backend/)
DATABASE_URL=

# development | production
ENV=development

# Bluesky LIVE — create App Password at https://bsky.app/settings/app-passwords
# (NOT your normal login password — see docs/BLUESKY_SETUP.md)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# false = real posts only | true = fake posts when API blocked (dev without Bluesky account)
BLUESKY_DEMO_FALLBACK=false

# Collectors: 24 = once per day (Render default) | 1 = hourly for local testing
COLLECT_INTERVAL_HOURS=24

# Badge stays LIVE if data is newer than this many hours (use 30 with daily collection)
DATA_STALE_HOURS=30

# Production only — your Vercel URL for CORS (e.g. https://pulsecup.vercel.app)
FRONTEND_URL=
